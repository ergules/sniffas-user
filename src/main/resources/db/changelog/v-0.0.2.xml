<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">
    <changeSet author="merg" id="v002-1-create-refresh-tokens">
        <createTable tableName="refresh_tokens">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="created_at" type="datetime"/>
            <column name="created_by" type="BIGINT"/>
            <column name="deleted" type="BIT(1)"/>
            <column name="updated_at" type="datetime"/>
            <column name="updated_by" type="BIGINT"/>
            <column name="version" type="INT"/>
            <column name="token" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="expiry_date" type="datetime">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet author="merg" id="v002-2-refresh-tokens-user-fk">
        <addForeignKeyConstraint baseColumnNames="user_id" baseTableName="refresh_tokens"
                                 constraintName="FK_refresh_tokens_user"
                                 referencedColumnNames="id" referencedTableName="users"/>
    </changeSet>
    <changeSet author="merg" id="v002-3-refresh-tokens-token-index">
        <createIndex indexName="idx_refresh_tokens_token" tableName="refresh_tokens">
            <column name="token"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
